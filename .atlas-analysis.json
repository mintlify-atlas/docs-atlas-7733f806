  "keyFeatures": [
    "Pure NumPy implementation — no deep learning frameworks required",
    "Modular layer system: InputLayer, HiddenLayer, OutputLayer",
    "Multiple activation functions: Sigmoid, ReLU, Tanh, Softmax",
    "Multiple loss functions: MSE, Binary Cross-Entropy, Categorical Cross-Entropy",
    "Flexible weight initialization: normal random, uniform random, Xavier, He, LeCun",
    "Gradient-descent training with epoch-based and threshold-based stopping",
    "Built-in examples: XOR, binary autoencoder, image autoencoder, MNIST classification"
  ],
